<?xml version="1.0" encoding="utf-8"?>
<!--
  One finished game in the home screen's history. Outcome on the left, who and
  what in the middle, rating change on the right — the three things a player
  scans a history for.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <!-- Fixed width, so the text beside it lines up on every row. -->
    <TextView
        android:id="@+id/outcomeText"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        tools:text="Win"
        tools:textColor="@color/history_win" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/opponentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:text="vs testuser_bob" />

        <TextView
            android:id="@+id/modeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Eval bar · 10 min" />
    </LinearLayout>

    <!-- GONE when the server sent no rating change for this game. -->
    <TextView
        android:id="@+id/ratingDeltaText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        tools:text="+16" />
</LinearLayout>
