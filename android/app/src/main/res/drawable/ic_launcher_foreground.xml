<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon's foreground: the logo, inset so it stays inside the
     66dp safe circle of the 108dp canvas whatever mask the launcher applies.
     Left/right differ because the artwork sits ~6% right of its own canvas
     centre (the whisper arcs); the uneven inset re-centres it. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/logo_chesswhisper"
    android:insetBottom="19%"
    android:insetLeft="15%"
    android:insetRight="23%"
    android:insetTop="19%" />
