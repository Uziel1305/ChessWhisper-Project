<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card: a faint diagonal sheen over a translucent fill, with a thin
     lavender edge. Shared by every card on Home and Game. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/card_radius" />
    <gradient
        android:angle="315"
        android:endColor="@color/glass_fill"
        android:startColor="@color/glass_fill_strong" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
