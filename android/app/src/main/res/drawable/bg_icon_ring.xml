<?xml version="1.0" encoding="utf-8"?>
<!-- The feedback icon's circle. Drawn in white so a single tint recolours it:
     tinting keeps each part's alpha, so the fill stays a faint wash of the
     verdict colour and the ring stays solid. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/icon_ring_fill" />
    <stroke
        android:width="1.5dp"
        android:color="@color/white" />
</shape>
