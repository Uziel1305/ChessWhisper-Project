    <!-- CW-149's feedback panel: one colour per classification, best to worst.
         An unrecognised classification (CLAUDE.md: the vocabulary may grow)
         falls back to feedback_neutral rather than crashing on an unmapped one.
         Tuned for the dark background, one distinct hue each (teal, green,
         yellow, orange, red) so neighbouring verdicts never read as shades of
         one another; the verdict label is always shown too. -->
    <color name="feedback_best">#FF2DD4BF</color>
    <color name="feedback_good">#FF4ADE80</color>
    <color name="feedback_inaccuracy">#FFFACC15</color>
    <color name="feedback_mistake">#FFFB923C</color>
    <color name="feedback_blunder">#FFF87171</color>
    <color name="feedback_neutral">#FFA5A3C9</color>

    <!-- CW-214's history rows: one colour per outcome. An unrecognised outcome
         falls back to history_draw's neutral grey rather than crashing. -->
    <color name="history_win">#FF4ADE80</color>
    <color name="history_loss">#FFF87171</color>
    <color name="history_draw">#FFA5A3C9</color>

    <!-- CW-153's eval bar: White's share and Black's share of the bar, plus the
         mate label's colour on each. A label always sits on its owner's own
         fill, so each label colour is picked to contrast with that fill. -->
    <color name="eval_bar_white">#FFF0F0F0</color>
    <color name="eval_bar_black">#FF3A3A3A</color>
    <color name="eval_bar_label_on_white">#FF212121</color>
    <color name="eval_bar_label_on_black">#FFFAFAFA</color>
</resources>