# Copy this file to `.env` in this same directory, then run:
#   docker compose up --build
#
# Compose reads `.env` from beside docker-compose.yml, so it belongs at the repo
# root — not in server/. `.env` is gitignored; never commit real secrets.
# The values below work as-is for local development.

# ---- Postgres (the `db` service) ----
# Dev-only password. No POSTGRES_USER is set, so the user defaults to `postgres`
# (which is what the healthcheck's `pg_isready -U postgres` expects).
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=chesswhisper

# ---- Server (the `server` service) ----
# The host is `db` — the compose service name — not localhost, because the server
# connects over the compose network. Keep the password and database name in sync
# with the two values above or the server won't be able to connect.
DATABASE_URL=postgresql://postgres:devpassword@db:5432/chesswhisper

# The one published host port, carrying both REST and the WebSocket hub.
# The Android debug build targets http://10.0.2.2:3000/ (see BASE_URL in
# android/app/build.gradle.kts) — keep the two in sync.
PORT=3000

# ---- Not used yet ----
# JWT_SECRET is needed once login is implemented (CW-14); no server code reads it
# today. When you add it, also pass it through to the `server` service in
# docker-compose.yml, and generate it as high-entropy random — never a memorable
# string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# JWT_SECRET=
