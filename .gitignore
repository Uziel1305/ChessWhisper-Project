Thumbs.db
Desktop.ini
.DS_Store
*.log


# ---- ML dataset pipeline ----
# The Lichess dumps and everything derived from them. Tens of GB, and fully
# reproducible from the URLs and sampling parameters recorded in ml/notes,
# which is what makes ignoring them lossless rather than lossy.
ml/data/

# ---- README media ----
# Original screen recordings; the GIFs in docs/media are what the README uses.
docs/media/raw/

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/


# ---- ML experiment artifacts ----
# ~52 MB of checkpoints, exported weights and per-position prediction dumps
# across thirty-odd runs, all reproducible from the notebooks and the dataset.
# The history files stay: a few KB each, and they ARE the experiment record —
# every run's config, its validation curve, and what it changed from the
# baseline. Losing those loses the reason the shipped model was chosen.
ml/models/*
!ml/models/*_history.json

# Notebooks, except the ones the results actually rest on.
ml/notebooks/*
!ml/notebooks/model2.ipynb
!ml/notebooks/model5CNN.ipynb
!ml/notebooks/model6.ipynb
!ml/notebooks/model6_run7.ipynb
!ml/notebooks/model6_run13.ipynb